# 환경 설정 (개인 정보 포함)
.env
servers.conf
config/grafana/provisioning/alerting/contact-points.yml
config/grafana/provisioning/alerting/templates.yml

# setup.sh가 생성하는 파일
config/alloy/alloy-config.alloy
scripts/start-alloy.sh
scripts/start-alloy.bat

# generate-dashboards.py가 servers.conf의 group마다 생성하는 대시보드 폴더
config/grafana/provisioning/dashboards/*/

# ~/.gitignore_global에 docker가 있는 경우 이 프로젝트에서 제외
!docker/

# start.sh 백그라운드 PID 추적 파일
.start.pids

# 데이터 볼륨
data/
